{
  "name": "Walaa-Insurance-Digital-Tranformation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "yarn@4.1.1",
  "workspaces": [
    "./shared-common/*",
    "./web-apps/*",
    "./mobile-apps/*"
  ],
  "scripts": {
    "test": "jest",
    "dev:shared-module": "yarn workspace @dpm/shared-module dev",
    "build:shared-module": "yarn workspace @dpm/shared-module build:prod",
    "build-mock:shared-module": "yarn workspace @dpm/shared-module build:mock",
    "dev-mock:main-app": "yarn build-mock:shared-module && yarn workspace @dpm/main-app dev-latest",
    "build-dev:shared-module": "yarn workspace @dpm/shared-module build:dev",
    "build-dev-latest:shared-module": "yarn workspace @dpm/shared-module build:dev-latest",
    "build-dev:main-app": "yarn build-dev:shared-module && yarn workspace @dpm/main-app build:dev",
    "build-dev-latest:main-app": "yarn build-dev-latest:shared-module && yarn workspace @dpm/main-app build:dev-latest",
    "build-stage:shared-module": "yarn workspace @dpm/shared-module build:stage",
    "build-stage-latest:shared-module": "yarn workspace @dpm/shared-module build:stage-latest",
    "build-stage:main-app": "yarn build-stage:shared-module && yarn workspace @dpm/main-app build:stage",
    "build-stage-latest:main-app": "yarn build-stage-latest:shared-module && yarn workspace @dpm/main-app build:stage-latest",
    "build-preprod:shared-module": "yarn workspace @dpm/shared-module build:preprod",
    "build-preprod:main-app": "yarn build-preprod:shared-module && yarn workspace @dpm/main-app build:preprod",
    "build:main-app": "yarn build:shared-module && yarn workspace @dpm/main-app build:prod",
    "dev:main-app": "yarn build-dev:shared-module && yarn workspace @dpm/main-app dev",
    "dev-latest:main-app": "yarn build-dev-latest:shared-module && yarn workspace @dpm/main-app dev-latest",
    "stage:main-app": "yarn build-stage-latest:shared-module && yarn workspace @dpm/main-app stage-latest",
    "test:corporate-portal": "yarn workspace @dpm/corporate-portal test",
    "test:consumer-portal": "yarn workspace @dpm/consumer-portal test",
    "preview:main-app": "yarn workspace @dpm/main-app preview"
  },
  "license": "MIT",
  "dependencies": {
    "@react-spring/web": "^9.7.5"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
}
