{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declarationMap": true,
    "allowImportingTsExtensions": true,
    "baseUrl": "./src",
    // "jsx": "react-jsx"
    "paths": {
      "components/*": ["./components/*"],
      "assets/*": ["./assets/*"],
      "@app-shell/*": ["../../app-shell/src/*"],
      "@consumer-portal/*": ["../../consumer-portal/src/*"]
    },
    "typeRoots": ["node_modules/@types","node_modules", "./typings", "../../node_modules/@types"],
    "types": [ "node", "jest","vite/client"],
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }],
  "typeRoots": ["./typings"]
}
