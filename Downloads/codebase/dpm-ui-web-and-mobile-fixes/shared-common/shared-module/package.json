{
  "name": "@dpm/shared-module",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port 4200 --mode sandbox",
    "build:prod": "tsc && vite build --mode prod",
    "build:dev": "tsc && vite build --mode sandbox",
    "build:mock": "tsc && vite build --mode mock",
    "build:dev-latest": "tsc -p tsconfig.node.json && vite build --mode sandbox-latest",
    "build:stage": "tsc && vite build --mode stage",
    "build:stage-latest": "tsc && vite build --mode stage-latest",
    "build:preprod": "tsc && vite build --mode preprod",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/components.es.js",
      "require": "./dist/components.umd.js"
    }
  },
  "main": "./dist/components.umd.js",
  "module": "./dist/components.es.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@reduxjs/toolkit": "^2.6.0",
    "@tanstack/react-query": "^5.66.11",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/dompurify": "^3.0.5",
    "axios": "^1.6.8",
    "bootstrap": "^5.3.3",
    "crypto-js": "^4.2.0",
    "dompurify": "^3.1.6",
    "path": "^0.12.7",
    "react": "^18.2.0",
    "react-bootstrap": "^2.10.4",
    "react-dom": "^18.2.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.23.0",
    "sass": "^1.77.8",
    "vite-plugin-dts": "^3.9.0",
    "vite-tsconfig-paths": "^4.3.2"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "eslint-plugin-unused-imports": "^4.1.4",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  }
}
